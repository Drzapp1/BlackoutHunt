PORT=8787
PUBLIC_BASE_URL=http://127.0.0.1:8787
# Optional. If omitted, a local secret is generated in data/state-secret.txt.
STATE_SECRET=

# Bind address. 127.0.0.1 = host only. Set 0.0.0.0 to accept LAN/classroom feedback.
BIND_HOST=127.0.0.1
# Optional. Locks the /admin feedback dashboard. If omitted, one is generated in
# data/admin-token.txt and the full dashboard URL is printed to the console at startup.
ADMIN_TOKEN=
# Optional. Override where players.json / feedback.jsonl / telemetry.jsonl are stored.
DATA_DIR=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Optional: classroom rate limits (per IP / 5 min) ---
# FEEDBACK_RATE_LIMIT=300
# TELEMETRY_RATE_LIMIT=600

# --- Optional: direct email backup of each feedback submission ---
# Emails feedback to FEEDBACK_EMAIL_TO via SMTP (Gmail default). Leave SMTP_PASS empty to
# disable. For Gmail, create an App Password (requires 2-Step Verification) and use it as
# SMTP_PASS. Test with: node ./email-notify.mjs --test
FEEDBACK_EMAIL_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
FEEDBACK_EMAIL_FROM=
# EMAIL_FEEDBACK_KINDS=bug,idea,praise,other,survey
